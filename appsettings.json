{
  "ConnectionStrings": {
    "ShopDbConnection": ""
  },
  "JwtSettings": {
    "Issuer": "ShopAPI",
    "Audience": "ShopAPIClients",
    "ExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 7
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Security.Authentication": "Warning",
      "Security.Authorization": "Warning",
      "Security.RateLimiting": "Warning",
      "ShopAPI.Observability": "Information"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*"
}
